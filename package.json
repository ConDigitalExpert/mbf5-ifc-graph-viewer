{
  "name": "mbf5-ifc-graph-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Premium IFC knowledge graph viewer with a confidence gated Jev decision layer.",
  "scripts": {
    "build:comparison": "node scripts/build-comparison-index.mjs",
